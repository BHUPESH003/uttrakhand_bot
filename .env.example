# Copy this file to apps/bot/.env and fill in real values.
# All of these are read + validated by apps/bot/src/config.ts on startup.

# Permanent (or temporary) access token for your WhatsApp Business app.
# Meta dashboard: WhatsApp > API Setup > Temporary access token
# (or a permanent token from a System User, for anything beyond local testing).
WHATSAPP_TOKEN=

# The "Phone number ID" shown in Meta dashboard > WhatsApp > API Setup.
# NOT the actual phone number — it's a numeric ID Meta assigns to that number.
PHONE_NUMBER_ID=

# A string YOU make up. You'll type this exact value into the Meta dashboard
# when registering the webhook, so Meta can prove the verification request
# is legitimate. Anything works, e.g. a random uuid.
VERIFY_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI4OTUwNzk4MDUxIiwibmFtZSI6IkJodXBlc2ggWWFkYXYiLCJhZG1pbiI6dHJ1ZSwiaWF0IjoxNTE2MjM5MDIyfQ.tq4_1vhjEJakK2GAw5KbT8Cbhfe20dt4MojOXDCTMK4

# Graph API version to call. Meta deprecates old versions periodically;
# bump this when they email you a deprecation notice.
GRAPH_API_VERSION=v21.0

# Used in later phases (links sent inside WhatsApp messages, e.g. a
# call-to-action button that opens a claim form).
WEB_FORM_URL=https://example.com/form

# Used in later phases (an image sent as a WhatsApp message, e.g. a welcome
# banner). Must be a public HTTPS URL — Meta's servers fetch it directly.
BANNER_IMAGE_URL=https://example.com/banner.png

# Port the Fastify server listens on locally.
PORT=3001

# Postgres connection string. Matches docker-compose.yml at the repo root
# by default — run `docker compose up -d` then this just works. Also needs
# to exist in packages/db/.env (see packages/db/.env.example) so the
# Prisma CLI (migrate/generate/seed) can find it when run standalone.
DATABASE_URL="postgresql://uttarakhand_bot:uttarakhand_bot@localhost:5432/uttarakhand_bot?schema=public"

# How long (minutes) a user can go quiet before their next message
# restarts the conversation at WELCOME instead of resuming mid-flow.
SESSION_IDLE_MINUTES=30

# Shared secret apps/admin sends (as the `x-internal-secret` header) to
# call POST /internal/notify-approved. Make up any random string, and set
# the SAME value in apps/admin/.env.local's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=change-me-to-a-random-string

# The external AI service backing the "Chat with us" menu option — see
# apps/bot/src/flow/aiChat.ts. We POST to `${AI_SERVICE_URL}/v1/converse`
# with `Authorization: Bearer ${AI_SERVICE_TOKEN}`.
AI_SERVICE_URL=https://cachatbot.pelocal.net/uk-eseva/v1/converse
AI_SERVICE_TOKEN=change-me-to-a-random-string
