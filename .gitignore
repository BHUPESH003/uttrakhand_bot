.matha/cortex/analysis.json
.matha/cortex/stability.json
.matha/cortex/co-changes.json

# Generated by `pnpm --filter bot catalog:csv` — regenerate instead of committing.
apps/bot/catalog/
# Commerce demo keys + Flow flags (`pnpm --filter bot demo:keys`, demo:config) — never commit the private key.
apps/bot/.demo-data/
