# Real deploy-time secrets (domains/ports are fine to commit, but this file
# also ends up holding CERTBOT_EMAIL etc. — copy deploy/.env.deploy.example
# instead of editing that template in place).
deploy/.env.deploy

# matha: rebuilt from git history on read — not worth merge-conflicting over.
