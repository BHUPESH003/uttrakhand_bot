# Copy to packages/db/.env — the Prisma CLI (migrate/generate/studio/seed)
# reads this file when run from within packages/db. The running bot reads
# its own copy from apps/bot/.env (same value, see apps/bot/.env.example).
#
# Matches the docker-compose.yml at the repo root:
DATABASE_URL="postgresql://uttarakhand_bot:uttarakhand_bot@localhost:5432/uttarakhand_bot?schema=public"
