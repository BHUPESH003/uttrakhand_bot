# Copy to apps/admin/.env.local (Next.js loads this automatically).

# Must point at the same Postgres database apps/bot and apps/web use.
# See docker-compose.yml at the repo root for local Postgres.
DATABASE_URL="postgresql://uttarakhand_bot:uttarakhand_bot@localhost:5432/uttarakhand_bot?schema=public"

# Demo-only: the single shared password for the admin login form. This is
# NOT real auth — no per-user accounts, no hashing, no rate limiting. Fine
# for a demo, replace before this is ever exposed publicly.
ADMIN_PASSWORD=change-me

# Must match apps/bot's INTERNAL_API_SECRET exactly — sent as the
# `x-internal-secret` header when admin calls the bot to notify a user.
INTERNAL_API_SECRET=change-me-to-a-random-string

# Base URL of the running apps/bot server, used to call
# POST /internal/notify-approved after an approval.
BOT_INTERNAL_URL=http://localhost:3001

# Base URL this admin app is reachable at, INCLUDING the /admin path when
# deployed (this app is reverse-proxied at /admin in production — see
# deploy/README.md). Used to build the certificate PDF link stored on the
# application (certificatePdfPath) — WhatsApp's servers fetch that URL
# directly, so it must be a real public HTTPS URL:
#   local ngrok demo:  https://<ngrok-subdomain>.ngrok-free.app
#   real deployment:   https://<DOMAIN>/admin
ADMIN_PUBLIC_URL=http://localhost:3002
