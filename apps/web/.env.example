# Copy to apps/web/.env.local (Next.js loads this automatically).
#
# Must point at the same Postgres database apps/bot writes handoff tokens
# and applications to. See docker-compose.yml at the repo root for local
# Postgres, and packages/db/.env.example.
DATABASE_URL="postgresql://uttarakhand_bot:uttarakhand_bot@localhost:5432/uttarakhand_bot?schema=public"

# Base URL of the running apps/bot server, called after a successful
# submission to send the applicant a WhatsApp confirmation with their
# reference number. Must match apps/bot's INTERNAL_API_SECRET exactly.
BOT_INTERNAL_URL=http://localhost:3001
INTERNAL_API_SECRET=change-me-to-a-random-string
