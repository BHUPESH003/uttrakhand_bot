# Single-domain reverse proxy: bot at the root, admin dashboard under
# /admin (matches apps/admin's next.config.ts basePath). HTTP-only here on
# purpose: 04-setup-nginx-tls.sh runs `certbot --nginx` right after
# installing this, which rewrites the file in place to add the HTTPS
# server block and the redirect — don't hand-add a listen 443 block here,
# certbot owns that part.
server {
    listen 80;
    server_name ${DOMAIN};

    # More specific prefix — nginx matches the longest prefix regardless
    # of block order, so this always wins over location / for /admin/*.
    location /admin {
        proxy_pass http://127.0.0.1:${ADMIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:${BOT_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
