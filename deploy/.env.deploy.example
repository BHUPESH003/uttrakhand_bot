# Copy this to deploy/.env.deploy on the VM and fill in real values.
# .env.deploy is gitignored — every script under deploy/scripts/ sources it
# via _lib.sh.

# Domains that must already have a DNS A record pointing at this VM's
# public IP BEFORE you run 04-setup-nginx-tls.sh — Let's Encrypt's HTTP-01
# challenge needs that to already resolve, it won't wait for you.
BOT_DOMAIN=bot.example.com
ADMIN_DOMAIN=admin.example.com

# Local ports the two Node services listen on — nginx reverse-proxies to
# these. Must match apps/bot's PORT and the -p flag baked into apps/admin's
# "start" script (next start -p 3002).
BOT_PORT=3000
ADMIN_PORT=3002

# Email Let's Encrypt uses for certificate expiry / renewal-failure notices.
CERTBOT_EMAIL=you@example.com

# System user the two services run as — 01-vm-bootstrap.sh creates it if
# missing. Never run the Node services as root.
SERVICE_USER=uttarakhand

# Branch each deploy script resets the checkout to (git fetch + reset
# --hard origin/$GIT_BRANCH) — this VM's copy is a deploy target, not
# somewhere to hand-edit, so treat any local changes here as disposable.
GIT_BRANCH=main
